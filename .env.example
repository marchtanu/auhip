# Voice mode: classic (local speech recognition + Ollama + configured TTS) or gemini_live
VOICE_MODE_ENGINE=classic
GEMINI_LIVE_VOICE=Puck

# Local speech and model configuration
STT_ENGINE=whisper
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TTS_ENGINE=edge
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=qwen2.5:7b
LOCAL_TIMEOUT_SECONDS=45.0
LOCAL_MAX_RETRIES=2

# Local semantic-memory embeddings (install once with: ollama pull nomic-embed-text)
AUHIP_EMBEDDING_MODEL=nomic-embed-text
AUHIP_EMBEDDING_DIMENSION=768

# Local-first: disable cloud escalation unless you opt in.
# Gemini Live also requires per-session audio-sharing approval in the desktop app.
CLOUD_ENABLED=false
GOOGLE_API_KEY=replace-with-your-key-if-you-enable-Gemini
CLOUD_MODEL_NAME=gemini-flash-latest
CLOUD_TIMEOUT_SECONDS=15.0
CLOUD_MAX_RETRIES=3

# Optional personal workspace outside this repository
# SECOND_BRAIN_PATH=D:\\path\\to\\march_workspace

# Keep disabled unless a reviewed file mutation or shell command is needed.
# AUHIP_ALLOW_UNSAFE_TOOLS=true
